<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <!-- Cross-grid Corridor: West to East (Traverses Grid 1 then Grid 2) -->
    <flow id="f_w_e" begin="0.00" end="3600.00" perHour="60.00" from="-E11" to="E21"/>

    <!-- Cross-grid Corridor: East to West (Traverses Grid 2 then Grid 1) -->
    <flow id="f_e_w" begin="0.00" end="3600.00" perHour="60.00" from="-E21" to="E11"/>

    <!-- Grid 1 North-South Flow -->
    <flow id="f_g1_ns" begin="0.00" end="3600.00" perHour="45.00" from="-E12" to="E13"/>

    <!-- Grid 1 South-North Flow -->
    <flow id="f_g1_sn" begin="0.00" end="3600.00" perHour="45.00" from="-E13" to="E12"/>

    <!-- Grid 2 North-South Flow -->
    <flow id="f_g2_ns" begin="0.00" end="3600.00" perHour="45.00" from="-E22" to="E23"/>

    <!-- Grid 2 South-North Flow -->
    <flow id="f_g2_sn" begin="0.00" end="3600.00" perHour="45.00" from="-E23" to="E22"/>

    <!-- Turning Flow: West to Grid 1 North -->
    <flow id="f_turn_w_g1n" begin="0.00" end="3600.00" perHour="35.00" from="-E11" to="E12"/>

    <!-- Turning Flow: East to Grid 2 South -->
    <flow id="f_turn_e_g2s" begin="0.00" end="3600.00" perHour="35.00" from="-E21" to="E23"/>
</routes>
