<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <!-- Real-World Scenario: High-Speed Arterial Corridor (100-120 km/h, rapid RSU traversal) -->
    <vType id="highway_car" accel="3.5" decel="5.0" length="4.8" maxSpeed="33.33"/>

    <!-- Fast cross-corridor throughput -->
