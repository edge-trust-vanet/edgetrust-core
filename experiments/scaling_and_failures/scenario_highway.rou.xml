    <flow id="f_e_w" type="highway_car" begin="0.00" end="3600.00" period="3.00" from="-E21" to="E11" departSpeed="max"/>
    <flow id="f_g1_ns" type="highway_car" begin="0.00" end="3600.00" period="4.00" from="-E12" to="E13" departSpeed="max"/>
    <flow id="f_g1_sn" type="highway_car" begin="0.00" end="3600.00" period="4.00" from="-E13" to="E12" departSpeed="max"/>
    <flow id="f_g2_ns" type="highway_car" begin="0.00" end="3600.00" period="4.00" from="-E22" to="E23" departSpeed="max"/>
    <flow id="f_g2_sn" type="highway_car" begin="0.00" end="3600.00" period="4.00" from="-E23" to="E22" departSpeed="max"/>
</routes>
